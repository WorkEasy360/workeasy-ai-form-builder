# Local development configuration. Copy to .env (git-ignored) and adjust.
# Every value here is a throwaway local default for services bound to
# 127.0.0.1 by infra/docker-compose.yml. Never reuse them in any shared
# or deployed environment, and never put real credentials in this file.

NODE_ENV=development
LOG_LEVEL=info

# --- Host ports published by infra/docker-compose.yml -----------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
IDENTITY_PORT=5556

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=workeasy_forms
POSTGRES_USER=workeasy_local
POSTGRES_PASSWORD=local-dev-only

# Superuser connection: used only by `pnpm db:setup` to create roles, the
# database and the schema, and by integration tests to create a test database.
DATABASE_ADMIN_URL=postgres://workeasy_local:local-dev-only@127.0.0.1:5432/postgres
# One URL per database role (packages/database/src/roles.ts). User names must
# match the role names; `pnpm db:setup` sets each role's password from its URL.
DATABASE_MIGRATION_URL=postgres://workeasy_owner:local-owner-only@127.0.0.1:5432/workeasy_forms
DATABASE_URL=postgres://workeasy_api:local-api-only@127.0.0.1:5432/workeasy_forms
DATABASE_WORKER_URL=postgres://workeasy_worker:local-worker-only@127.0.0.1:5432/workeasy_forms
DATABASE_PUBLIC_URL=postgres://workeasy_public:local-public-only@127.0.0.1:5432/workeasy_forms

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- S3-compatible object storage (RustFS locally) ----------------------------
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=local-dev-access
OBJECT_STORAGE_SECRET_KEY=local-dev-secret-key
OBJECT_STORAGE_BUCKET_QUARANTINE=workeasy-quarantine
OBJECT_STORAGE_BUCKET_CLEAN=workeasy-clean
OBJECT_STORAGE_BUCKET_EXPORTS=workeasy-exports
# Where browsers send presigned uploads; must be reachable from the respondent's browser.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# --- Malware scanner (ClamAV clamd) -------------------------------------------
SCANNER_HOST=127.0.0.1
SCANNER_PORT=3310

# --- Email sink (Mailpit) -----------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- Application processes ----------------------------------------------------
API_PORT=4000
CONSOLE_PORT=3000
RESPONDENT_PORT=3001
WORKER_POLL_INTERVAL_MS=5000
# Worker liveness endpoint (GET /health/live).
WORKER_HEALTH_PORT=4001

# --- Sign-in (OIDC) -----------------------------------------------------------
# Local Dex provider from infra/docker-compose.yml. Fixture users and their
# password are listed in infra/dex/config.yaml.
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_CLIENT_ID=workeasy-console
OIDC_CLIENT_SECRET=local-console-client-secret
# Public origin of the console. The OIDC redirect URI is <origin>/auth/callback,
# and it is the only origin allowed to send cookie-authenticated mutations.
CONSOLE_PUBLIC_URL=http://localhost:3000
# Public origin of the respondent app (share links, QR codes, embeds).
RESPONDENT_PUBLIC_URL=http://localhost:3001
# Where the console forwards /api and /auth requests.
API_INTERNAL_URL=http://127.0.0.1:4000
# Encrypts the short-lived login-transaction cookie. At least 32 characters.
SESSION_SECRET=local-dev-only-session-secret-change-me-0000
SESSION_TTL_HOURS=12
# Must be true anywhere served over HTTPS; the API refuses false in production.
SESSION_COOKIE_SECURE=false

# AI authoring (AI-01). "stub" is a deterministic local provider that needs no
# account; "openai" or "gemini" call that provider with the key below and
# AI_MODEL (the model ID your account uses). "disabled" hides AI; manual
# editing never depends on it. Keys are read by the worker only and must never
# be committed. stub is refused in production.
AI_PROVIDER=stub
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email and webhooks (AUT-01). Encrypts webhook signing secrets at rest; the API
# and the worker must share it. 32 random bytes, base64. Generate your own with:
#   node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64\"))"
INTEGRATION_SECRET_KEY=bG9jYWwtZGV2LW9ubHktaW50ZWdyYXRpb24ta2V5ISE=
# Local development only: lets webhooks reach http:// and private addresses
# (for example a receiver on your machine). The API and worker refuse it in production.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Notification email. Locally this is Mailpit (inbox at http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Workeasy <notifications@workeasy.test>
