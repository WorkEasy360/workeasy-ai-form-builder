# Local development configuration. Copy to .env (git-ignored) and adjust.
# Every value here is a throwaway local default for services bound to
# 127.0.0.1 by infra/docker-compose.yml. Never reuse them in any shared
# or deployed environment, and never put real credentials in this file.

NODE_ENV=development
LOG_LEVEL=info

# --- Host ports published by infra/docker-compose.yml -----------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=workeasy_forms
POSTGRES_USER=workeasy_local
POSTGRES_PASSWORD=local-dev-only

# Superuser connection: used only by `pnpm db:setup` to create roles, the
# database and the schema, and by integration tests to create a test database.
DATABASE_ADMIN_URL=postgres://workeasy_local:local-dev-only@127.0.0.1:5432/workeasy_forms
# One URL per database role (packages/database/src/roles.ts). User names must
# match the role names; `pnpm db:setup` sets each role's password from its URL.
DATABASE_MIGRATION_URL=postgres://workeasy_owner:local-owner-only@127.0.0.1:5432/workeasy_forms
DATABASE_URL=postgres://workeasy_api:local-api-only@127.0.0.1:5432/workeasy_forms
DATABASE_WORKER_URL=postgres://workeasy_worker:local-worker-only@127.0.0.1:5432/workeasy_forms
DATABASE_PUBLIC_URL=postgres://workeasy_public:local-public-only@127.0.0.1:5432/workeasy_forms

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- S3-compatible object storage (RustFS locally) ----------------------------
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=local-dev-access
OBJECT_STORAGE_SECRET_KEY=local-dev-secret-key
OBJECT_STORAGE_BUCKET_QUARANTINE=workeasy-quarantine
OBJECT_STORAGE_BUCKET_CLEAN=workeasy-clean
OBJECT_STORAGE_BUCKET_EXPORTS=workeasy-exports

# --- Email sink (Mailpit) -----------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- Application processes ----------------------------------------------------
API_PORT=4000
CONSOLE_PORT=3000
RESPONDENT_PORT=3001
WORKER_POLL_INTERVAL_MS=5000
