{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workeasy:forms:definition:1.0",
  "title": "Workeasy form definition v1.0",
  "description": "P1 structural contract. Semantic engine must additionally validate references, uniqueness, field-specific settings and rule graphs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "locale", "pages", "fields", "rules", "theme", "success"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 4000},
    "locale": {"type": "string", "minLength": 2, "maxLength": 35},
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "fieldIds"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "maxLength": 200},
          "fieldIds": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "fields": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/field"}},
    "rules": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/rule"}},
    "theme": {
      "type": "object", "additionalProperties": false,
      "required": ["accent", "background", "text", "radius"],
      "properties": {
        "accent": {"$ref": "#/$defs/color"},
        "background": {"$ref": "#/$defs/color"},
        "text": {"$ref": "#/$defs/color"},
        "radius": {"type": "integer", "minimum": 0, "maximum": 24}
      }
    },
    "success": {
      "type": "object", "additionalProperties": false, "required": ["message"],
      "properties": {"message": {"type": "string", "minLength": 1, "maxLength": 2000}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,79}$"},
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "option": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 300}}
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "label", "required", "settings"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["text", "textarea", "email", "phone", "url", "integer", "decimal", "date", "time", "dropdown", "radio", "multi_select", "checkbox", "consent", "rating", "file"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 300},
        "helpText": {"type": "string", "maxLength": 2000},
        "required": {"type": "boolean"},
        "settings": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "placeholder": {"type": "string", "maxLength": 300},
            "minLength": {"type": "integer", "minimum": 0, "maximum": 20000},
            "maxLength": {"type": "integer", "minimum": 1, "maximum": 20000},
            "min": {"oneOf": [{"type": "number"}, {"type": "string", "maxLength": 40}]},
            "max": {"oneOf": [{"type": "number"}, {"type": "string", "maxLength": 40}]},
            "options": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/option"}},
            "minSelections": {"type": "integer", "minimum": 0, "maximum": 100},
            "maxSelections": {"type": "integer", "minimum": 1, "maximum": 100},
            "allowedMimeTypes": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "maxLength": 100}},
            "maxFileBytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
            "maxFiles": {"type": "integer", "minimum": 1, "maximum": 5},
            "consentTextVersion": {"type": "string", "minLength": 1, "maxLength": 80}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["dropdown", "radio", "multi_select"]}}}, "then": {"properties": {"settings": {"type": "object", "required": ["options"]}}}},
        {"if": {"properties": {"type": {"const": "file"}}}, "then": {"properties": {"settings": {"type": "object", "required": ["allowedMimeTypes", "maxFileBytes", "maxFiles"]}}}},
        {"if": {"properties": {"type": {"const": "consent"}}}, "then": {"properties": {"settings": {"type": "object", "required": ["consentTextVersion"]}}}}
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["all"],
          "properties": {"all": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/condition"}}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["any"],
          "properties": {"any": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/condition"}}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["not"],
          "properties": {"not": {"$ref": "#/$defs/condition"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["fieldId", "op", "value"],
          "properties": {
            "fieldId": {"$ref": "#/$defs/id"},
            "op": {"enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains"]},
            "value": {"type": ["string", "number", "boolean"], "maxLength": 2000}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["fieldId", "op"],
          "properties": {"fieldId": {"$ref": "#/$defs/id"}, "op": {"enum": ["isEmpty", "isNotEmpty"]}}
        }
      ]
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["id", "when", "action"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "when": {"$ref": "#/$defs/condition"},
        "action": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["type", "targetFieldId", "onTrue", "onFalse"],
              "properties": {
                "type": {"enum": ["setVisibility", "setRequired"]},
                "targetFieldId": {"$ref": "#/$defs/id"},
                "onTrue": {"type": "boolean"}, "onFalse": {"type": "boolean"}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["type", "sourcePageId", "targetPageId"],
              "properties": {
                "type": {"const": "skipToPage"},
                "sourcePageId": {"$ref": "#/$defs/id"}, "targetPageId": {"$ref": "#/$defs/id"}
              }
            }
          ]
        }
      }
    }
  }
}
