# Settings for Workeasy Forms on AWS (OPS-03; docs/aws-deployment.md).
# Store the filled-in file as the Secrets Manager secret "workeasy-forms/production/env"
# (created by hand, docs/aws-manual-setup.md). deploy.sh writes it to the server with mode 600.
# Never commit the filled-in file. Values marked GENERATE: run infra/aws/new-secrets.sh.

# Public addresses (DNS A records must point at the EC2 server's Elastic IP).
CONSOLE_DOMAIN=forms-admin.example.com
FORMS_DOMAIN=forms.example.com
ACME_EMAIL=ops@example.com
CONSOLE_PUBLIC_URL=https://forms-admin.example.com
RESPONDENT_PUBLIC_URL=https://forms.example.com
LOG_LEVEL=info
WORKER_JOB_CONCURRENCY=8

# --- Database: your Aurora/RDS cluster, in a database of its own -------------
# The app gets its own database (workeasy_forms) and four roles that can reach
# nothing else; other databases on the cluster are untouched. Connections are
# encrypted and the server's certificate is verified.
#
# DATABASE_ADMIN_URL is needed only for the first deploy (it creates the
# database and roles) and when you change a role password: use the cluster's
# master user, then delete this line from the secret. Without it, deploys only
# apply migrations.
DATABASE_ADMIN_URL=postgres://MASTER_USER:MASTER_PASSWORD@CLUSTER_ENDPOINT:5432/postgres?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
# The role names are fixed (packages/database/src/roles.ts); the passwords are yours. GENERATE each.
DATABASE_MIGRATION_URL=postgres://workeasy_owner:GENERATE@CLUSTER_ENDPOINT:5432/workeasy_forms?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
DATABASE_URL=postgres://workeasy_api:GENERATE@CLUSTER_ENDPOINT:5432/workeasy_forms?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
DATABASE_WORKER_URL=postgres://workeasy_worker:GENERATE@CLUSTER_ENDPOINT:5432/workeasy_forms?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
DATABASE_PUBLIC_URL=postgres://workeasy_public:GENERATE@CLUSTER_ENDPOINT:5432/workeasy_forms?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem

# --- Files: Amazon S3 through the server's IAM role (no keys) ----------------
# The four buckets from docs/aws-manual-setup.md.
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_BUCKET_QUARANTINE=workeasy-forms-quarantine-ACCOUNT-REGION
OBJECT_STORAGE_BUCKET_CLEAN=workeasy-forms-files-ACCOUNT-REGION
OBJECT_STORAGE_BUCKET_EXPORTS=workeasy-forms-exports-ACCOUNT-REGION
DELETION_LEDGER_BUCKET=workeasy-forms-deletion-ledger-ACCOUNT-REGION

# --- Sign-in: your OpenID Connect identity provider ---------------------------
# Redirect URIs to register: https://<CONSOLE_DOMAIN>/auth/callback and https://<FORMS_DOMAIN>/public/v1/auth/callback
# Amazon Cognito: https://cognito-idp.<region>.amazonaws.com/<user pool ID>
OIDC_ISSUER_URL=https://login.example.com
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME

SESSION_SECRET=GENERATE
SESSION_TTL_HOURS=12
# Encrypts webhook signing secrets at rest. Never change it on a running installation.
INTEGRATION_SECRET_KEY=GENERATE

# --- Email: Amazon SES (SMTP interface) --------------------------------------
# SES console -> SMTP settings -> Create SMTP credentials. The sender's domain
# must be verified in SES, and the account out of the SES sandbox.
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SES_SMTP_USERNAME
SMTP_PASSWORD=SES_SMTP_PASSWORD
MAIL_FROM=Workeasy Forms <forms@example.com>

# --- AI (optional; each organization opts in) ---------------------------------
AI_PROVIDER=disabled
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
