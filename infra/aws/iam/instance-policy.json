{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Files",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::QUARANTINE_BUCKET/*",
        "arn:aws:s3:::FILES_BUCKET/*",
        "arn:aws:s3:::EXPORTS_BUCKET/*"
      ]
    },
    {
      "Sid": "LedgerWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::LEDGER_BUCKET/*"]
    },
    {
      "Sid": "ReadReleases",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::RELEASES_BUCKET/*"]
    },
    {
      "Sid": "PullImages",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
      "Resource": ["arn:aws:ecr:REGION:ACCOUNT_ID:repository/workeasy-forms"]
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "ReadSettings",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": ["arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:workeasy-forms/production/env-*"]
    }
  ]
}
