{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PushImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:DescribeImages"
      ],
      "Resource": ["arn:aws:ecr:REGION:ACCOUNT_ID:repository/workeasy-forms"]
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "UploadRelease",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::RELEASES_BUCKET/*"]
    },
    {
      "Sid": "RunDeployDocument",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand"],
      "Resource": ["arn:aws:ssm:REGION::document/AWS-RunShellScript"]
    },
    {
      "Sid": "RunDeployOnTaggedServer",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand"],
      "Resource": ["arn:aws:ec2:REGION:ACCOUNT_ID:instance/*"],
      "Condition": { "StringEquals": { "ssm:resourceTag/workeasy-forms": "production" } }
    },
    {
      "Sid": "FollowDeploy",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations", "ec2:DescribeInstances"],
      "Resource": "*"
    }
  ]
}
