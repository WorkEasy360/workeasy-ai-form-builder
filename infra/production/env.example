# Production/staging configuration for infra/production/docker-compose.yml.
# Create the real file on the server with ./new-env.sh, which fills
# every secret with fresh random values; then edit the CHANGE_ME lines.
# Keep it at infra/production/.env with mode 600. Never commit it.

# Image to run; deploy.sh sets this per release.
WORKEASY_IMAGE=ghcr.io/OWNER/workeasy-forms:CHANGE_ME

# Public hostnames (DNS A/AAAA records must point at this server).
CONSOLE_DOMAIN=forms-admin.example.com
FORMS_DOMAIN=forms.example.com
FILES_DOMAIN=forms-files.example.com
ACME_EMAIL=ops@example.com
CONSOLE_PUBLIC_URL=https://forms-admin.example.com
RESPONDENT_PUBLIC_URL=https://forms.example.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://forms-files.example.com

LOG_LEVEL=info

# PostgreSQL superuser, used only by the migrate job to provision roles.
POSTGRES_DB=workeasy_forms
POSTGRES_USER=workeasy_admin
POSTGRES_PASSWORD=GENERATED
DATABASE_ADMIN_URL=postgres://workeasy_admin:GENERATED@postgres:5432/postgres
# One login per runtime role; the role names are fixed (packages/database/src/roles.ts).
DATABASE_MIGRATION_URL=postgres://workeasy_owner:GENERATED@postgres:5432/workeasy_forms
DATABASE_URL=postgres://workeasy_api:GENERATED@postgres:5432/workeasy_forms
DATABASE_WORKER_URL=postgres://workeasy_worker:GENERATED@postgres:5432/workeasy_forms
DATABASE_PUBLIC_URL=postgres://workeasy_public:GENERATED@postgres:5432/workeasy_forms

OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=GENERATED
OBJECT_STORAGE_SECRET_KEY=GENERATED
OBJECT_STORAGE_BUCKET_QUARANTINE=workeasy-quarantine
OBJECT_STORAGE_BUCKET_CLEAN=workeasy-files
OBJECT_STORAGE_BUCKET_EXPORTS=workeasy-exports

# Your identity provider (OpenID Connect). Register the redirect URI
# https://<CONSOLE_DOMAIN>/auth/callback and https://<FORMS_DOMAIN>/public/v1/auth/callback.
OIDC_ISSUER_URL=https://login.example.com
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME

SESSION_SECRET=GENERATED
SESSION_TTL_HOURS=12
# Encrypts webhook signing secrets at rest. Changing it makes stored secrets unreadable.
INTEGRATION_SECRET_KEY=GENERATED

# Outgoing email (your provider's SMTP relay).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM=Workeasy Forms <forms@example.com>

# AI is off until both a provider and its key are set, and each organization opts in.
AI_PROVIDER=disabled
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
