{
  "name": "@workeasy/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express API: private /api/v1, public /public/v1 and /callbacks/v1 routes.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@workeasy/observability": "workspace:*",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
