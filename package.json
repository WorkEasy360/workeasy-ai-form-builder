{
  "name": "workeasy-ai-form-builder",
  "private": true,
  "description": "Multi-tenant form builder for the Workeasy product family.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.11.2 <13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "check:bundles": "node scripts/client-bundle-check.mjs",
    "embed:sample": "node scripts/embed-sample.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "db:setup": "pnpm --filter @workeasy/database db setup",
    "db:migrate": "pnpm --filter @workeasy/database db migrate",
    "db:seed": "pnpm --filter @workeasy/database db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --wait --wait-timeout 180 postgres redis object-storage mail identity && docker compose -f infra/docker-compose.yml --env-file .env run --rm object-storage-init",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "infra:reset": "docker compose -f infra/docker-compose.yml --env-file .env down -v",
    "infra:ps": "docker compose -f infra/docker-compose.yml --env-file .env ps",
    "browsers:install": "playwright install chromium-headless-shell"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.0.4",
    "oxlint": "1.87.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
